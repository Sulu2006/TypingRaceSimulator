    {
      "id": "2be39678-3a4d-47ab-a03b-872245d06da9",
      "cell_type": "code",
      "source": "Typist typist3 = new Typist('③', \"RACER3\", 0.30);\r\n\r\ntypist3.typeCharacter();\r\ntypist3.typeCharacter();\r\ntypist3.burnOut(3);\r\n\r\nSystem.out.println(\"Before reset:\");\r\nSystem.out.println(\"Progress: \" + typist3.getProgress());\r\nSystem.out.println(\"Burnt out? \" + typist3.isBurntOut());\r\nSystem.out.println(\"Turns remaining: \" + typist3.getBurnoutTurnsRemaining());\r\n\r\ntypist3.resetToStart();\r\n\r\nSystem.out.println(\"After reset:\");\r\nSystem.out.println(\"Progress: \" + typist3.getProgress());\r\nSystem.out.println(\"Burnt out? \" + typist3.isBurntOut());\r\nSystem.out.println(\"Turns remaining: \" + typist3.getBurnoutTurnsRemaining());",
      "metadata": {
